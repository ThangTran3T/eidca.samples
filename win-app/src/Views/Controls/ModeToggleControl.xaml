<UserControl x:Class="eIDCA.WinApp.Views.Controls.ModeToggleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">
    <Border Background="{StaticResource BgCard2Brush}" Padding="12">
        <StackPanel>

            <!-- Toggle row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="CHẾ ĐỘ" Style="{StaticResource SectionHeader}" Margin="0"/>
                    <TextBlock Style="{StaticResource Caption}">
                        <Run Text="{Binding IsMock, Converter={StaticResource ModeNameConverter}}"/>
                    </TextBlock>
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding IsMock, Mode=TwoWay}"
                                 OnContent="Mock" OffContent="Live"
                                 VerticalAlignment="Center"/>
            </Grid>

            <!-- Mock mode info -->
            <StackPanel Visibility="{Binding ShowMockPanel, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}">
                <TextBlock Text="Mock Server URL" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding MockApiUrl, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource InputBox}"
                         FontFamily="Consolas" FontSize="11" Opacity="0.7"/>
            </StackPanel>

            <!-- Live mode config -->
            <StackPanel Visibility="{Binding ShowLivePanel, Mode=OneWay, Converter={StaticResource BoolToVisibleConverter}}"
                       >
                <StackPanel>
                    <TextBlock Text="API Base URL" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding LiveApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputBox}" FontSize="11"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="API Key" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding LiveApiKey, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputBox}" FontSize="11"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Partner Code" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding LivePartnerCode, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputBox}" FontSize="11"/>
                </StackPanel>
                <Button Content="✅ Áp dụng" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ApplyConfigCommand}" HorizontalAlignment="Stretch"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>

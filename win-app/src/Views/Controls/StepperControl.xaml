<UserControl x:Class="eIDCA.WinApp.Views.Controls.StepperControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

        <StackPanel.Resources>
            <Style x:Key="StepCircle" TargetType="Border">
                <Setter Property="Width"  Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Background"   Value="#2a2a4a"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="BorderBrush"   Value="{StaticResource BorderBrush_}"/>
            </Style>
            <Style x:Key="StepLine" TargetType="Border">
                <Setter Property="Width"  Value="48"/>
                <Setter Property="Height" Value="2"/>
                <Setter Property="Background" Value="{StaticResource BorderBrush_}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </StackPanel.Resources>

        <!-- Step 0 -->
        <StackPanel x:Name="Step0" Orientation="Vertical" Width="80" HorizontalAlignment="Center">
            <Border Style="{StaticResource StepCircle}" HorizontalAlignment="Center">
                <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="Step0Label_" HorizontalAlignment="Center" FontSize="10"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Style="{StaticResource StepLine}" x:Name="Line01"/>

        <!-- Step 1 -->
        <StackPanel x:Name="Step1" Orientation="Vertical" Width="80" HorizontalAlignment="Center">
            <Border Style="{StaticResource StepCircle}" HorizontalAlignment="Center">
                <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="Step1Label_" HorizontalAlignment="Center" FontSize="10"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Style="{StaticResource StepLine}" x:Name="Line12"/>

        <!-- Step 2 -->
        <StackPanel x:Name="Step2" Orientation="Vertical" Width="80" HorizontalAlignment="Center">
            <Border Style="{StaticResource StepCircle}" HorizontalAlignment="Center">
                <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="Step2Label_" HorizontalAlignment="Center" FontSize="10"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

    </StackPanel>
</UserControl>

<UserControl x:Class="eIDCA.WinApp.Views.Controls.TabButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root_">
    <!--
        DataContext = this (set in code-behind)
        Command/Index/Text/IsSelected đều là DependencyProperty trên TabButton
        CommandParameter truyền Index (int) vào RelayCommand<int>
    -->
    <Button Command="{Binding Command, ElementName=Root_}"
            CommandParameter="{Binding Index, ElementName=Root_}"
            Background="Transparent" BorderThickness="0" Cursor="Hand"
            Padding="16,12" Height="48">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="BtnBorder" Background="Transparent"
                        Padding="{TemplateBinding Padding}"
                        BorderThickness="0,0,0,2"
                        BorderBrush="Transparent">
                    <TextBlock x:Name="Label"
                               Text="{Binding Text, ElementName=Root_}"
                               FontSize="13" FontWeight="Medium"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="MouseOver">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Label" Storyboard.TargetProperty="Foreground">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TextPrimaryBrush}"/>
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Border>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, ElementName=Root_}" Value="True">
                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        <Setter TargetName="Label"     Property="Foreground"  Value="{StaticResource PrimaryBrush}"/>
                        <Setter TargetName="Label"     Property="FontWeight"  Value="SemiBold"/>
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>

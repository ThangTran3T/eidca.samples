<UserControl x:Class="eIDCA.WinApp.Views.CompanySign.Step1UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:eIDCA.WinApp.Views.Controls">
    <StackPanel>
        <TextBlock Text="Bước 1 — Upload tài liệu (Tổ chức)" Style="{StaticResource H2}"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource BgCard2Brush}" CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                <TextBlock Text="{Binding SelectedFileName}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis"/>
            </Border>
            <Button Grid.Column="1" Content="📂 Chọn file PDF" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseFileCommand}"/>
        </Grid>
        <Grid Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource BgCard2Brush}" CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mẫu chữ ký:" Style="{StaticResource Caption}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TemplateName}" Style="{StaticResource Body}"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Button Grid.Column="1" Content="⚙️ Tải mẫu JSON" Style="{StaticResource SecondaryButton}"
                    Command="{Binding LoadTemplateCommand}"/>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Số CCCD" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding IdNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Company ID" Style="{StaticResource Caption}"/>
                <TextBox Text="{Binding CompanyId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="{Binding StatusMsg}" Style="{StaticResource StatusLabel}"
                   Visibility="{Binding StatusMsg, Converter={StaticResource EmptyToHiddenConverter}}"/>
        <Button Content="📤 Upload &amp; Lấy Challenge" Style="{StaticResource PrimaryButton}"
                Command="{Binding UploadCommand}" HorizontalAlignment="Left" Padding="18,9"/>
        <controls:CodePanelControl DataContext="{Binding CodePanel}"/>
    </StackPanel>
</UserControl>

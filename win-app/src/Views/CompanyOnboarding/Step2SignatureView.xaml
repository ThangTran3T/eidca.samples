<UserControl x:Class="eIDCA.WinApp.Views.CompanyOnboarding.Step2SignatureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:eIDCA.WinApp.Views.Controls">
    <StackPanel>
        <TextBlock Text="Bước 2 — Gửi Signature (Tổ chức)" Style="{StaticResource H2}"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="DỮ LIỆU NFC" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{Binding NfcSummary}" Style="{StaticResource Body}"/>
                    <Button Content="🔄 Retry đọc thẻ" Style="{StaticResource SecondaryButton}"
                            Command="{Binding RetryNfcCommand}" FontSize="11" HorizontalAlignment="Left"/>
                    <StackPanel>
                        <TextBlock Text="Phone" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}" FontSize="12"/>
                        <TextBlock Text="Email" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardPanel}" Padding="8">
                <StackPanel>
                    <TextBlock Text="SELFIE" Style="{StaticResource SectionHeader}"/>
                    <Border CornerRadius="6" ClipToBounds="True" Height="120" Background="#0d0d1a">
                        <Image Source="{Binding SelfieImage}" Stretch="UniformToFill"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Text="{Binding StatusMsg}" Style="{StaticResource StatusLabel}"
                   Visibility="{Binding StatusMsg, Converter={StaticResource EmptyToHiddenConverter}}"/>
        <Button Content="✍️ Gửi Signature" Style="{StaticResource PrimaryButton}"
                Command="{Binding SendSignatureCommand}" HorizontalAlignment="Left" Padding="20,10"/>
        <controls:CodePanelControl DataContext="{Binding CodePanel}"/>
    </StackPanel>
</UserControl>

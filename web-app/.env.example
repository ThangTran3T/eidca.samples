# Environment Variables — Web App

# =============================================
# eIDCA API Configuration
# =============================================
# Base URL của eIDCA API (sandbox hoặc production)
VITE_EIDCA_API_BASE_URL=https://sandbox-api.eidca.vn/v1

# Credentials do eIDCA cấp cho đối tác
VITE_EIDCA_CLIENT_ID=your_client_id_here
VITE_EIDCA_CLIENT_SECRET=your_client_secret_here

# =============================================
# SocketIO Bridge Configuration
# =============================================
# URL của SocketIO Bridge Service chạy local trên máy người dùng
# Service này giao tiếp trực tiếp với đầu đọc 3TE4/HN212 qua USB
VITE_SOCKET_BRIDGE_URL=ws://localhost:9090

# Timeout kết nối SocketIO (ms)
VITE_SOCKET_TIMEOUT=5000

# =============================================
# Application Configuration
# =============================================
VITE_APP_NAME=eIDCA Web Integration Demo
VITE_APP_ENV=development

# =============================================
# HƯỚNG DẪN
# =============================================
# 1. Copy file này thành .env: cp .env.example .env
# 2. Điền CLIENT_ID và CLIENT_SECRET từ eIDCA
# 3. KHÔNG commit file .env lên git (đã có trong .gitignore)
